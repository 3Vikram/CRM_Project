# Public HTTPS URL used in email tracking pixels.
# Set MAIL_TRACKING_BASE_URL to your deployed backend or HTTPS tunnel URL, without a trailing slash.
# TRACKING_BASE_URL remains supported for backward compatibility.
MAIL_TRACKING_BASE_URL=https://YOUR-PUBLIC-BACKEND-DOMAIN
# Optional legacy name; use the setting above for new deployments.
TRACKING_BASE_URL=
TRACKING_DIAGNOSTICS=false
 
# Existing backend settings
PORT=5001
# Set an absolute path on the company server. Production startup requires this.
SALES_DB_PATH=
# Optional absolute backup directory; defaults to database/backups (ignored by Git).
# Run `node database/scripts/backup-sales-db.js` before schema/data maintenance.
SALES_BACKUP_DIR=
# Used only by the manual MongoDB lead importer, not by the Sales API server.
MONGO_URI=
JWT_SECRET=replace-with-a-cryptographically-random-secret
# Admin login uses bcrypt hashes; configure at least one email/hash pair.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SALES_ADMIN_EMAIL=
SALES_ADMIN_PASSWORD_HASH=
