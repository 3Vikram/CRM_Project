# Internal Inventory API origin from inventory/backend/.env PORT.
INVENTORY_API_URL=http://127.0.0.1:5000
# Generate a unique secret (at least 32 characters) and configure it in both backend .env files.
INVENTORY_PRODUCTS_SERVICE_SECRET=

# URL used in email tracking pixels. Google-hosted Gmail may fetch images through
# Google's image proxy, which cannot reach private 192.168.x.x/LAN addresses.
# For Gmail recipients, use a publicly reachable HTTPS hostname that proxies /api
# to sales/backend. A private LAN URL works only when the email client fetches the
# image directly while connected to the company network.
# Set MAIL_TRACKING_BASE_URL to that reachable tracking origin.
# A reachable Cloudflare Quick Tunnel is acceptable for development only; use a stable
# custom hostname or named Cloudflare Tunnel for production.
# If this URL is unreachable, campaign sending verifies the forwarded request host as a fallback.
# TRACKING_BASE_URL remains supported for backward compatibility.
MAIL_TRACKING_BASE_URL=https://YOUR-PUBLIC-BACKEND-DOMAIN
# Optional legacy name; use the setting above for new deployments.
TRACKING_BASE_URL=
TRACKING_DIAGNOSTICS=false
 
# Optional authenticated SMTP overrides: SMTP_HOST, SMTP_PORT, and SMTP_SECURE.
# Confirm the submission host, port, and TLS mode with the company email administrator.
# If unset, the Sales mail service currently defaults to Google SMTP on port 465
# with implicit TLS.
# Existing backend settings
PORT=5001
MONGO_URI=replace-with-your-mongodb-connection-string
JWT_SECRET=replace-with-a-long-random-secret