PORT=5000
MONGO_URI=mongodb://localhost:27017/3vikram-crm

# Inventory sign-in credentials (configure with deployment secrets)
INVENTORY_LOGIN_EMAIL=
INVENTORY_LOGIN_PASSWORD=
# Use a random secret of at least 32 characters
INVENTORY_AUTH_SECRET=

# SMTP Configuration (Email Service for Daily Stock Email)
# Update these with your email provider credentials
# Example: Gmail, SendGrid, AWS SES, etc.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@3vikram.com
