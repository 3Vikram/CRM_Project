  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "5.7.3",
    "vitest": "^2.1.9"
  }
}
